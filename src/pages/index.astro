---
import Layout from "../components/Layout.astro";

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase.slice(0, -1) : rawBase;
---

<Layout title="Litia - The future of learning">
  <style>
    .screenshot-card { padding: 0; overflow: hidden; display: flex; flex-direction: column; width: 100%; max-width: 260px; }
    .screenshot-img-wrapper { overflow: hidden; border-bottom: 1px solid rgba(0,0,0,0.05); }
    .screenshot-img { width: 100%; max-height: 60vh; object-fit: contain; display: block; }
    .screenshot-caption { padding: 20px; font-weight: 700; text-align: center; color: var(--text-main); font-size: 1.2rem; }
    
    .hero-buttons { display: flex; gap: 16px; align-items: center; margin-bottom: 8px; flex-wrap: wrap; }
    .hero-split {
      display: flex;
      flex-direction: column;
      gap: 40px;
      align-items: center;
      padding-top: 40px;
    }
    @media (min-width: 800px) {
      .hero-split {
        flex-direction: row;
        text-align: left;
        justify-content: space-between;
      }
      .hero-content {
        flex: 1;
        max-width: 55%;
      }
      .hero-visual {
        flex: 1;
        max-width: 45%;
      }
    }
    .micro-copy {
      font-size: 0.9rem;
      color: var(--text-muted);
      margin-bottom: 32px;
    }
    .hero-photo {
      border-radius: var(--radius-card);
      box-shadow: var(--shadow-hover);
      width: 100%;
      object-fit: cover;
    }

    .privacy-shield {
      display: inline-flex; align-items: flex-start; gap: 12px;
      background: #F5F5F7; border: 1px solid rgba(0,0,0,0.1);
      padding: 16px 20px; border-radius: 16px; max-width: 600px; margin-bottom: 64px;
    }
    .privacy-shield svg { flex-shrink: 0; margin-top: 2px; }
    .privacy-shield p { font-size: 0.95rem; color: var(--text-muted); line-height: 1.4; margin: 0; }
    .privacy-shield strong { color: var(--text-main); }

    .scroll-magic-section {
      height: 300vh; 
      position: relative;
      margin-top: 80px;
    }
    .scroll-sticky-viewport {
      position: sticky;
      top: 10vh; 
      height: 80vh;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      justify-content: center;
    }
    .scroll-horizontal-track {
      display: flex;
      /* Change this number to bring them closer or further apart */
      gap: 30px; 
      width: max-content; 
      padding: 0 calc(50vw - 140px); 
      will-change: transform;
      transition: transform 0.15s ease-out; 
    }
    .scroll-slide {
      width: 280px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
    }
  </style>

  <section class="hero hero-split">
    <div class="hero-content">
      <h1 class="grand-title" style="color: var(--apple-blue);">Litia is the future of learning.</h1>
      <p class="lede">
        Litia teaches builds the readers, writers, and mathematicians of the future by supplementing educators through technology! By reading along with learners' eyes, Litia builds pattern recognition for new readers.
      </p>
      <div class="hero-buttons">
        <a href={`${base}/download/`} class="button bg-green">Learn with Litia for free</a>
        <a href={`${base}/educators/`} class="button bg-orange">I'm a Teacher</a>
        <a href={`${base}/educators/`} class="button bg-purple">I'm a Researcher</a>
      </div>
      <p class="micro-copy">Private, secure, and ad-free for both free and paid accounts.</p>
    </div>
    <div class="hero-visual reveal-right">
      <img src={`${base}/winky.png`} alt="A smiling elementary learner actively collaborating with a teacher using the Litia app on an iPad" class="hero-photo" />
    </div>
  </section>
  <div style="text-align: center; margin-top: 200px;">
    <h2 style="font-size: 2.5rem; font-weight: 800; letter-spacing: -0.02em; color: var(--apple-green);">The Litia Platform</h2>
    <p class="subtle">Scroll down to explore</p>
  </div>
  <section class="scroll-magic-section" id="screenshot-scroller">
    <div class="scroll-sticky-viewport">
      <div class="scroll-horizontal-track" id="scroll-track">
        
        <div class="scroll-slide">
          <div class="card screenshot-card">
            <div class="screenshot-img-wrapper">
              <img src={`${base}/home-screen.png`} alt="Litia Home Screen" class="screenshot-img" />
            </div>
            <div class="screenshot-caption">Learning Activities</div>
          </div>
        </div>

        <div class="scroll-slide">
          <div class="card screenshot-card">
            <div class="screenshot-img-wrapper">
              <img src={`${base}/quiz-screen.png`} alt="Litia Quiz Interaction" class="screenshot-img" />
            </div>
            <div class="screenshot-caption">Eye-Tracked Quizzes</div>
          </div>
        </div>

        <div class="scroll-slide">
          <div class="card screenshot-card">
            <div class="screenshot-img-wrapper">
              <img src={`${base}/writing-screen.png`} alt="Litia Creative Drawing" class="screenshot-img" />
            </div>
            <div class="screenshot-caption">Learning to Write</div>
          </div>
        </div>

        <div class="scroll-slide">
          <div class="card screenshot-card">
            <div class="screenshot-img-wrapper">
              <img src={`${base}/drawing-screen.png`} alt="Litia Creative Drawing" class="screenshot-img" />
            </div>
            <div class="screenshot-caption">Space to Create</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section style="margin-top: 40px; text-align: center;">
    <h2 style="font-size: 2.5rem; font-weight: 800; letter-spacing: -0.02em; color: var(--apple-purple);">Litia's Magic Recipe</h2>
    
    <div class="stackedGrid">
      <div class="card bg-blue reveal-left">
        <h3>Real technology teaches real skills</h3>
        <p>No ads, even for free guest users. No AI LLMs stealing your data. No personal information is retained or sold. We have built a learning tool that teaches the next generation, not a data harvester.</p>
      </div>
      
      <div class="card bg-red reveal-right">
        <h3>Learning at all stages</h3>
        <p>Eye tracking builds neural connections across letters, phonemes, and words. Reading and math are taught interactively through gaze-contingent programs to teach learners how to identify new symbols, letters, and words.</p>
      </div>
      
      <div class="card bg-green reveal-left">
        <h3>Progress you can see</h3>
        <p>Secure progress dashboards are available for adults and educators, displaying actionable data about a learner's educational trajectory without compromising privacy.</p>
      </div>
    </div>
  </section>

  <section style="margin-top: 40px; text-align: center;">
    <h2 style="font-size: 2.5rem; font-weight: 800; letter-spacing: -0.02em; color: var(--apple-blue);">Different Ways to Learn</h2>
    <p class="subtle" style="margin-bottom: 40px;">No hidden fees and no advertising.</p>
    
    <div class="cardGrid">
      <div class="card bg-orange reveal-up">
        <h3>Families & Individuals</h3>
        <p>A simple, low-cost monthly subscription provides full access to all reading, writing, and math modules for your learner. Cancel anytime.</p>
      </div>
      <div class="card bg-purple reveal-up"; style="transition-delay: 0.1s;">
        <h3>Schools & Educators</h3>
        <p>Bulk licensing available for classrooms. Access aggregated progress dashboards and secure, offline-capable deployments for your institution.</p>
        <a href={`${base}/contact/`} class="button" style="margin-top: 24px;">Learn about Litia in the classroom</a>
      </div>
      <div class="card bg-cyan reveal-up"; style="transition-delay: 0.2s;">
        <h3>Guest Access</h3>
        <p>Try Litia at no cost as a guest. Progress data, profiles, and growth are not saved between sessions, but all features are currently available to guest users.</p>
      </div>
    </div>
  </section>

  <script>
    document.addEventListener("DOMContentLoaded", () => {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('reveal-visible');
          }
        });
      }, { threshold: 0.15 });

      const hiddenElements = document.querySelectorAll('.reveal-left, .reveal-right, .reveal-up');
      hiddenElements.forEach((el) => observer.observe(el));

      const scroller = document.getElementById('screenshot-scroller');
      const track = document.getElementById('scroll-track');

      if (scroller && track) {
        window.addEventListener('scroll', () => {
          const rect = scroller.getBoundingClientRect();
          const scrollProgress = -rect.top / (rect.height - window.innerHeight);
          const clampedProgress = Math.max(0, Math.min(1, scrollProgress));
          
          // Calculate the exact pixel distance to move the track
          const maxScroll = track.scrollWidth - window.innerWidth;
          const translateX = clampedProgress * -maxScroll;
          
          track.style.transform = `translateX(${translateX}px)`;
        });
      }
    });
  </script>

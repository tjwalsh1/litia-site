---
import Layout from "../components/Layout.astro";

// Exact same logic used in Layout.astro for Winky
const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase.slice(0, -1) : rawBase;
---

<Layout title="Litia — The future of learning">
  <style>
    .screenshot-card { padding: 0; overflow: hidden; display: flex; flex-direction: column; }
    .screenshot-img-wrapper { overflow: hidden; border-bottom: 1px solid rgba(0,0,0,0.05); }
    .screenshot-img { width: 100%; height: auto; display: block; transition: transform 0.6s cubic-bezier(0.34, 1.56, 0.64, 1); }
    .screenshot-card:hover .screenshot-img { transform: scale(1.05); }
    .screenshot-caption { padding: 20px; font-weight: 700; text-align: center; color: var(--text-main); }
    
    .hero-buttons { display: flex; gap: 16px; align-items: center; margin-bottom: 32px; flex-wrap: wrap; }
    
    .privacy-shield {
      display: inline-flex; align-items: flex-start; gap: 12px;
      background: #F5F5F7; border: 1px solid rgba(0,0,0,0.1);
      padding: 16px 20px; border-radius: 16px; max-width: 600px; margin-bottom: 64px;
    }
    .privacy-shield svg { flex-shrink: 0; margin-top: 2px; }
    .privacy-shield p { font-size: 0.95rem; color: var(--text-muted); line-height: 1.4; margin: 0; }
    .privacy-shield strong { color: var(--text-main); }
  </style>

  <section class="hero" style="padding-top: 40px;">
    <div>
      <h1 class="grand-title">Litia is the future of learning.</h1>
      
      <p class="lede">
        Litia reads, counts, writes, and learns alongside your child. Powered by on-device eye tracking, it builds foundational literacy and mathematical skills.
      </p>

      <div class="hero-buttons">
        <a class="button primary" href={`${base}/contact/`} style="padding: 16px 32px; font-size: 1.1rem;">Request a demo</a>
        <a class="button" href={`${base}/educators/`} style="padding: 16px 32px; font-size: 1.1rem;">For Educators</a>
      </div>

      <div class="privacy-shield">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--apple-green)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
        </svg>
        <p>
          <strong>100% On-Device Privacy.</strong> We only need an email to set up your account. Absolutely zero student learning data or eye-tracking metrics ever leave your device.
        </p>
      </div>
    </div>
  </section>

  <section style="margin-top: 40px;">
    <h2 style="font-size: 2.5rem; font-weight: 800; letter-spacing: -0.02em;">Inside the App</h2>
    <p class="subtle" style="margin-bottom: 40px;">Interactive learning at a glance</p>
    
    <div class="cardGrid">
      <div class="card screenshot-card reveal-up">
        <div class="screenshot-img-wrapper">
          <img src={`${base}/home-screen.png`} alt="Litia Home Screen" class="screenshot-img" />
        </div>
        <div class="screenshot-caption">Guided Pathways</div>
      </div>
      <div class="card screenshot-card reveal-up" style="transition-delay: 0.1s;">
        <div class="screenshot-img-wrapper">
          <img src={`${base}/quiz-screen.png`} alt="Litia Quiz Interaction" class="screenshot-img" />
        </div>
        <div class="screenshot-caption">Eye-Tracked Quizzes</div>
      </div>
      <div class="card screenshot-card reveal-up" style="transition-delay: 0.2s;">
        <div class="screenshot-img-wrapper">
          <img src={`${base}/writing-screen.png`} alt="Litia Creative Drawing" class="screenshot-img" />
        </div>
        <div class="screenshot-caption">Writing Motor Skills</div>
      </div>
      <div class="card screenshot-card reveal-up" style="transition-delay: 0.2s;">
        <div class="screenshot-img-wrapper">
          <img src={`${base}/drawing-screen.png`} alt="Litia Creative Drawing" class="screenshot-img" />
        </div>
        <div class="screenshot-caption">Creative Rewards</div>
      </div>
    </div>
  </section>

  <section style="margin-top: 100px;">
    <h2 style="font-size: 2.5rem; font-weight: 800; letter-spacing: -0.02em;">Core Features</h2>
    
    <div class="stackedGrid">
      <div class="card bg-blue reveal-left">
        <h3>Real technology to teach real skills</h3>
        <p>No ads. No AI stealing data. No cloud storage required. No personal information is retained or sold. We built a tool, not a data harvester.</p>
      </div>
      
      <div class="card bg-orange reveal-right">
        <h3>Multilayered learning</h3>
        <p>Eye tracking builds neural connections across letters, phonemes, and words. Reading and math are taught interactively through gaze-contingent design.</p>
      </div>
      
      <div class="card bg-green reveal-left">
        <h3>Progress you can trust</h3>
        <p>Secure progress dashboards are available for adults and educators, displaying rich, actionable data about a student's reading trajectory.</p>
      </div>
    </div>
  </section>

  <section style="margin-top: 100px;">
    <h2 style="font-size: 2.5rem; font-weight: 800; letter-spacing: -0.02em;">Simple, Transparent Access</h2>
    <p class="subtle" style="margin-bottom: 40px;">No hidden fees.</p>
    
    <div class="cardGrid">
      <div class="card reveal-up">
        <h3>Families & Individuals</h3>
        <p>A simple, low-cost monthly subscription provides full access to all reading, writing, and math modules for your child. Cancel anytime.</p>
      </div>
      <div class="card reveal-up" style="transition-delay: 0.1s; border-top: 4px solid var(--apple-blue);">
        <h3>Schools & Educators</h3>
        <p>Bulk licensing available for classrooms. Access aggregated progress dashboards and secure, offline-capable deployments for your district.</p>
        <a href={`${base}/contact/`} class="button" style="margin-top: 24px;">Contact Sales</a>
      </div>
    </div>
  </section>

  <script>
    document.addEventListener("DOMContentLoaded", () => {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('reveal-visible');
          }
        });
      }, { threshold: 0.15 }); // Triggers when 15% of the card is visible

      const hiddenElements = document.querySelectorAll('.reveal-left, .reveal-right, .reveal-up');
      hiddenElements.forEach((el) => observer.observe(el));
    });
  </script>
</Layout>

---
import Layout from "../components/Layout.astro";
const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase.slice(0, -1) : rawBase;
---

<Layout title="Educators — Litia">
  <h1 class="pageTitle">Built for the classroom</h1>
  <p class="lede">Litia seamlessly integrates into early education environments, providing zero-setup learning and actionable student insights.</p>

  <div class="cardGrid">
    <div class="card">
      <h3>Zero Friction Deployment</h3>
      <p>Works flawlessly on standard iOS devices. No complex calibration or extra hardware required. Hand the iPad to the student, and they are learning.</p>
    </div>
    <div class="card">
      <h3>The Progress Dashboard</h3>
      <p>Stop guessing. See exactly which phonemes or sight words a student is struggling with, tracked automatically via their gaze and interaction.</p>
    </div>
    <div class="card">
      <h3>Offline & Secure</h3>
      <p>Litia runs entirely on-device. No internet connection is required for core activities, and absolutely no student PII is uploaded to the cloud.</p>
    </div>
  </div>

  <div class="prose">
    <h2>District Licensing & Subscriptions</h2>
    <p>
      We offer tiered subscription packages designed specifically for classrooms and entire school districts. Educator accounts include specialized tools to group students, track longitudinal data, and export reports for parent-teacher conferences.
    </p>
    <a class="button primary" href={`${base}/contact/`} style="margin-top: 16px;">Request Educational Pricing</a>
  </div>
</Layout>

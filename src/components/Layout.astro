---
const { 
  title = "Litia", 
  description = "On-device, privacy-first early literacy activities with eye tracking and text-to-speech." 
} = Astro.props;

// Uses simple relative paths for clean routing
const currentPath = Astro.url.pathname;

const isActive = (href) => {
  if (href === '/' && currentPath === '/') return "active";
  if (href !== '/' && currentPath.includes(href)) return "active";
  return "";
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    
    <link rel="icon" type="image/png" href="/Winky.png" />
  </head>
  <body>
    <header class="site-header">
      <div class="container">
        <div class="navbar">
          <a class="brand" href="/">
            <img src="/Winky.png" alt="Litia Logo" class="winky-logo" />
            <span>Litia</span>
          </a>

          <nav class="navlinks" aria-label="Primary navigation">
            <a href="/" class={isActive('/')}>Home</a>
            <a href="/research" class={isActive('/research')}>Research</a>
            <a href="/educators" class={isActive('/educators')}>Educators</a>
            <a href="/contact" class={isActive('/contact')}>Contact</a>
          </nav>
        </div>
      </div>
    </header>

    <main>
      <div class="container">
        <slot />
      </div>
    </main>

    <footer class="site-footer">
      <div class="container">
        <p>© {new Date().getFullYear()} Litia. Privacy-first, on-device learning.</p>
        <div class="footer-links">
          <a href="/privacy">Privacy Policy</a>
          <a href="/contact">Contact</a>
        </div>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  @import "../styles/global.css";
</style>

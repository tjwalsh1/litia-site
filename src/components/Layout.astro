/* ==========================================================
   1. CSS Variables & Theme
   ========================================================== */
:root {
  /* Colors - Bright, approachable, but professional */
  --bg-app: #F4F7F9; /* Very soft, cool grey-blue background */
  --surface: #FFFFFF;
  --text-main: #1E293B; /* Slate 800 */
  --text-muted: #64748B; /* Slate 500 */
  
  --brand-primary: #0EA5E9; /* Friendly sky blue */
  --brand-primary-hover: #0284C7;
  --brand-accent: #8B5CF6; /* Playful purple */

  /* Structural */
  --radius-card: 24px;
  --radius-button: 100px; /* Pill shape for kid-friendly vibe */
  --gap-bento: 24px;
  
  /* Shadows & Transitions */
  --shadow-sm: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
  --shadow-card: 0 10px 25px -5px rgba(0, 0, 0, 0.05), 0 8px 10px -6px rgba(0, 0, 0, 0.01);
  --shadow-hover: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 8px 10px -6px rgba(0, 0, 0, 0.05);
  --transition-bounce: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
  --transition-smooth: all 0.2s ease-in-out;
}

/* ==========================================================
   2. Reset & Typography
   ========================================================== */
*, *::before, *::after { box-sizing: border-box; }
body, h1, h2, h3, p, ul, li { margin: 0; padding: 0; }

body {
  background-color: var(--bg-app);
  color: var(--text-main);
  font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
}

a { color: inherit; text-decoration: none; transition: var(--transition-smooth); }
img { max-width: 100%; display: block; }

.container {
  max-width: 1100px;
  margin: 0 auto;
  padding: 0 24px;
}

/* ==========================================================
   3. Navbar
   ========================================================== */
.site-header {
  position: sticky;
  top: 0;
  z-index: 100;
  background: rgba(255, 255, 255, 0.85);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border-bottom: 2px solid rgba(0,0,0,0.03);
}

.navbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 80px;
}

.brand {
  display: flex;
  align-items: center;
  gap: 12px;
  font-weight: 800;
  font-size: 1.5rem;
  letter-spacing: -0.02em;
}

.winky-logo {
  width: 44px;
  height: 44px;
  border-radius: 12px;
  transition: var(--transition-bounce);
}

.brand:hover .winky-logo {
  transform: rotate(-10deg) scale(1.1);
}

.navlinks {
  display: flex;
  gap: 24px;
  align-items: center;
}

.navlinks a {
  color: var(--text-muted);
  font-weight: 700;
  font-size: 1.05rem;
}

.navlinks a:hover, .navlinks a.active {
  color: var(--brand-primary);
}

/* ==========================================================
   4. Buttons
   ========================================================== */
.button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: var(--surface);
  color: var(--text-main);
  font-weight: 800;
  font-size: 1rem;
  padding: 14px 28px;
  border-radius: var(--radius-button);
  border: 2px solid rgba(0,0,0,0.05);
  box-shadow: var(--shadow-sm);
  cursor: pointer;
  transition: var(--transition-bounce);
}

.button.primary {
  background: var(--brand-primary);
  color: white;
  border: none;
  box-shadow: 0 6px 0 var(--brand-primary-hover);
}

.button:hover { transform: translateY(-3px); }
.button.primary:hover { transform: translateY(-3px); box-shadow: 0 8px 0 var(--brand-primary-hover); }
.button.primary:active { transform: translateY(4px); box-shadow: 0 0 0 var(--brand-primary-hover); }

/* ==========================================================
   5. Bento Box Grid & Cards
   ========================================================== */
.cardGrid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
  gap: var(--gap-bento);
  margin-top: 32px;
}

.card {
  background: var(--surface);
  border-radius: var(--radius-card);
  padding: 32px;
  box-shadow: var(--shadow-card);
  border: 2px solid rgba(0,0,0,0.02);
  transition: var(--transition-bounce);
}

.card:hover {
  transform: translateY(-6px) scale(1.01);
  box-shadow: var(--shadow-hover);
  border-color: rgba(14, 165, 233, 0.3); /* Soft blue border on hover */
}

.card h3 {
  font-size: 1.25rem;
  font-weight: 800;
  margin-bottom: 12px;
  letter-spacing: -0.01em;
}

/* ==========================================================
   6. Typography Helpers & Layout
   ========================================================== */
main { padding: 60px 0 100px; }

h1.pageTitle { font-size: 3rem; font-weight: 900; letter-spacing: -0.03em; margin-bottom: 16px; }
.hero h1 { font-size: 3.5rem; font-weight: 900; letter-spacing: -0.04em; margin-bottom: 16px; line-height: 1.1; }

.lede { font-size: 1.25rem; color: var(--text-muted); font-weight: 500; margin-bottom: 32px; }
.subtle { color: var(--text-muted); font-size: 0.95rem; }

.ctaRow { display: flex; gap: 16px; margin-bottom: 48px; }

/* Prose (For Privacy, Contact, Educators pages) */
.prose {
  background: var(--surface);
  border-radius: var(--radius-card);
  padding: 40px;
  box-shadow: var(--shadow-card);
  border: 2px solid rgba(0,0,0,0.02);
}
.prose h2 { font-size: 1.8rem; font-weight: 800; margin: 32px 0 16px; letter-spacing: -0.02em; }
.prose h2:first-child { margin-top: 0; }
.prose p { margin-bottom: 16px; color: var(--text-muted); font-size: 1.1rem; }
.prose ul { padding-left: 24px; margin-bottom: 24px; color: var(--text-muted); font-size: 1.1rem; }
.prose li { margin-bottom: 8px; }
.prose a { color: var(--brand-primary); font-weight: 700; }
.prose a:hover { color: var(--brand-primary-hover); text-decoration: underline; }

/* ==========================================================
   7. Footer
   ========================================================== */
.site-footer {
  padding: 40px 0;
  text-align: center;
  color: var(--text-muted);
  font-weight: 500;
  border-top: 2px solid rgba(0,0,0,0.05);
}

---
const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase.slice(0, -1) : rawBase;

const currentPath = Astro.url.pathname;

const isActive = (path) => {
  const normalize = (p) => p.endsWith('/') ? p : p + '/';
  const current = normalize(currentPath);
  const target = normalize(base + path);
  
  if (path === '/' && current === normalize(base + '/')) return "active";
  if (path !== '/' && current.includes(path)) return "active";
  return "";
};

const { title = "Litia", description = "On-device, privacy-first early literacy." } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/png" href={`${base}/Winky.png`} />
  </head>
  <body>
    <header class="site-header">
      <div class="container">
        <div class="navbar">
          <a class="brand" href={`${base}/`}>
            <img src={`${base}/Winky.png`} alt="Litia" class="winky-logo bounce-hover blend-bg" />
            <span>Litia</span>
          </a>

          <nav class="navlinks">
            <a href={`${base}/research/`} class={isActive('/research/')}>Research</a>
            <a href={`${base}/educators/`} class={isActive('/educators/')}>Educators</a>
            <a href={`${base}/contact/`} class={isActive('/contact/')}>Contact</a>
          </nav>
        </div>
      </div>
    </header>

    <main>
      <div class="container">
        <slot />
      </div>
    </main>

    <footer class="site-footer">
      <div class="container">
        <p>© {new Date().getFullYear()} Litia. Privacy-first, on-device learning.</p>
        <div class="footer-links">
          <a href={`${base}/privacy/`}>Privacy Policy</a>
          <a href={`${base}/terms/`}>Terms of Service</a>
          <a href={`${base}/contact/`}>Contact</a>
        </div>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  @import "../styles/global.css";
</style>

---
const { 
  title = "Litia", 
  description = "On-device, privacy-first early literacy activities with eye tracking and text-to-speech." 
} = Astro.props;

// This ensures paths work perfectly on GitHub Pages
const baseUrl = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;

// Helper to highlight the active navigation link
const isActive = (href) => {
  if (href === baseUrl && currentPath === baseUrl) return "active";
  if (href !== baseUrl && currentPath.includes(href)) return "active";
  return "";
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    
    <link rel="icon" type="image/png" href={`${baseUrl}Winky.png`} />
  </head>
  <body>
    <header class="site-header">
      <div class="container">
        <div class="navbar">
          <a class="brand" href={baseUrl}>
            <img src={`${baseUrl}Winky.png`} alt="Winky Logo" class="winky-logo" />
            <span>Litia</span>
          </a>

          <nav class="navlinks" aria-label="Primary navigation">
            <a href={baseUrl} class={isActive(baseUrl)}>Home</a>
            <a href={`${baseUrl}research`} class={isActive(`${baseUrl}research`)}>Research</a>
            <a href={`${baseUrl}educators`} class={isActive(`${baseUrl}educators`)}>Educators</a>
            <a href={`${baseUrl}contact`} class={isActive(`${baseUrl}contact`)}>Contact</a>
          </nav>
        </div>
      </div>
    </header>

    <main>
      <div class="container">
        <slot />
      </div>
    </main>

    <footer class="site-footer">
      <div class="container">
        <p>© {new Date().getFullYear()} Litia. Privacy-first, on-device learning.</p>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  @import "../styles/global.css";
</style>

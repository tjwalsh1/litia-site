---
const { title = "Litia", description = "On-device, privacy-first early literacy activities with eye tracking and text-to-speech." } = Astro.props;
const path = Astro.url.pathname;
const isActive = (href) => (path === href ? "active" : "");
---

<!doctype html>
<html lang="en">
  <head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width" />
  <title>{title}</title>
  <link rel="icon" type="image/png" href="/Winky.png" />
</head>
<body>
  <nav class="navbar">
    <a href="/" class="brand">
      <img src="/Winky.png" alt="Winky" class="winky-logo" />
      <span class="brand-text">Litia</span>
    </a>
    
    <div class="nav-links">
      <a href="/educators">Educators</a>
      <a href="/research">Research</a>
      <a href="/contact">Contact</a>
    </div>
  </nav>
  
  <main>
    <slot />
  </main>
</body>
